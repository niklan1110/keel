# Settings for docker-compose.yml in this folder. The Keel installer writes this
# file for you with random passwords; to set it up by hand, copy it to .env and
# fill in the empty values (long random letters and digits; generate a set with
# `docker run --rm <keel image> generate-env`).

# The address your apps (and phones/laptops on your network) use to reach Keel's API:
# this server's IP address or hostname, port 8000, e.g. http://192.168.1.20:8000.
# Behind a tunnel or reverse proxy, the public HTTPS address, e.g. https://api.example.com
KEEL_PUBLIC_URL=http://change-me:8000
# Whether the internet can reach this server: "internet", "lan", or empty to
# judge from KEEL_PUBLIC_URL. On "internet", new projects start with sign-ups
# off (or confirmed by email when a mail server is set up). Set "internet" on a
# cloud server, whose own address looks private (the installer and ./keel init
# do when they recognise one).
KEEL_EXPOSURE=

# Postgres superuser password (only keel-migrate and keel-studio get it).
# Set once; changing it later doesn't change the database.
POSTGRES_PASSWORD=

# Base secret of Keel's internal database roles: keel-migrate derives each
# role's password from it and hands each service only its own.
KEEL_SERVICE_PASSWORD=

# Studio's master secret (sessions, two-factor encryption, download links).
KEEL_SECRET=

# Studio's token for keel-functions' internal endpoints (function logs).
KEEL_FUNCTIONS_TOKEN=

# Studio owner account (user: admin) on port 3000. Changing the password here
# later resets the owner's password to this value when Studio restarts.
KEEL_DASHBOARD_PASSWORD=

# Signs image-resize URLs (64 hex characters each).
IMGPROXY_KEY=
IMGPROXY_SALT=

# Studio sign-ins from the internet (through a tunnel or public address):
# 2fa = only for accounts with two-factor authentication, on, or off.
KEEL_STUDIO_INTERNET_LOGIN=2fa
# Host names Studio answers to besides IP addresses, localhost, local names
# (nas, nas.local, *.lan, *.ts.net) and the public addresses, comma-separated,
# for example studio.example.com (protects against DNS rebinding).
KEEL_STUDIO_HOSTS=
# Proxies whose X-Forwarded-For Keel believes, besides its own (the gateway and
# Cloudflare Tunnel): "host" for Caddy, nginx or tailscale serve on this
# machine (automatic for a port bound to 127.0.0.1), or addresses, CIDR ranges
# and container names, comma-separated.
KEEL_TRUSTED_PROXIES=
# Limits against slow or flooding clients. Seconds a request body may stall
# before it's closed, open connections per client address, and realtime
# (WebSocket) connections per address and per project.
KEEL_BODY_IDLE_TIMEOUT=120
KEEL_MAX_CONNECTIONS_PER_IP=500
KEEL_REALTIME_MAX_PER_IP=200
KEEL_REALTIME_MAX_PER_PROJECT=10000

# Ports and the interfaces they listen on. 127.0.0.1 keeps a port on this
# machine only; 0.0.0.0 opens it to your network (and to the internet on a
# server with a public address: Docker's published ports bypass ufw/firewalld).
# Studio and Postgres stay on this machine unless you open them on purpose.
KEEL_GATEWAY_PORT=8000
KEEL_GATEWAY_BIND=0.0.0.0
KEEL_STUDIO_PORT=3000
KEEL_STUDIO_BIND=127.0.0.1
KEEL_DB_PORT=5432
KEEL_DB_BIND=127.0.0.1
# Postgres connections from other machines need TLS (a self-signed certificate
# is made on first start) and a password, and the postgres superuser is refused
# unless this is "on". Keel's own containers and this machine are not affected.
KEEL_DB_REMOTE_SUPERUSER=off
# "remote" when Docker hides where connections come from (Docker Desktop on
# macOS and Windows, rootless Docker, Podman): there every client, this machine
# included, arrives from the Docker network's gateway, so with KEEL_DB_BIND=0.0.0.0
# those connections need TLS and can't sign in as postgres. "local" otherwise.
KEEL_DB_GATEWAY=local

# Studio asks GitHub once a day, while you use it, whether a newer Keel release
# exists (an anonymous request; nothing about this install is sent). "off" stops it.
KEEL_UPDATE_CHECK=on

# LAN addresses edge functions may call, such as a local Ollama or a NAS
# (comma separated: 192.168.1.50:11434,10.0.0.7 or a range up to /24).
# Every port of a listed address is reachable, whatever port you write.
# Never list this server or Keel's containers; Keel ignores those.
# KEEL_FUNCTIONS_ALLOW_LAN=
# This server's own LAN addresses, comma separated. They stay closed to
# functions inside an allowed range; without them, only single addresses can
# be allowed. The installer and ./keel init fill this in.
KEEL_HOST_ADDRESSES=

# Optional mail server for sign-up and password emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
