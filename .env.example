# Copy to .env, or run ./keel init to generate one with random secrets.

# --- Required secrets -------------------------------------------------------
# Superuser password for Postgres (only keel-migrate and keel-studio get it).
# Do not change it after the first start (the database keeps the old one).
POSTGRES_PASSWORD=
# Base secret of Keel's internal service roles. keel-migrate derives a separate
# password for each role from it on every start and hands each service only its
# own, so it can be changed any time. Only keel-migrate and keel-studio get it.
KEEL_SERVICE_PASSWORD=
# Studio's master secret (sessions, two-factor encryption, download links).
# Any long random string. Only keel-studio gets it.
KEEL_SECRET=
# Studio's token for keel-functions' internal endpoints (function logs).
# Optional: without it, one is derived from KEEL_SERVICE_PASSWORD.
KEEL_FUNCTIONS_TOKEN=
# Studio owner account. Add more accounts in Studio (Account and security).
# Changing the password here resets the owner's password on the next start.
KEEL_DASHBOARD_USERNAME=admin
KEEL_DASHBOARD_PASSWORD=

# --- Network ----------------------------------------------------------------
# The URL your apps use to reach the gateway (shown in Studio's Connect panel,
# used in auth emails and OAuth callbacks).
KEEL_PUBLIC_URL=http://localhost:8000
# Whether the internet can reach this server: "internet", "lan", or empty to
# judge from KEEL_PUBLIC_URL. On "internet", new projects start with sign-ups
# off (or confirmed by email when a mail server is set up). Set "internet" on a
# cloud server, whose own address looks private (the installer and ./keel init
# do when they recognise one).
KEEL_EXPOSURE=
# Host shown in Studio's Postgres connection string, when it differs from the
# host in KEEL_PUBLIC_URL (e.g. the API is behind a reverse proxy domain).
KEEL_PUBLIC_DB_HOST=
# Name shown in Studio's header, e.g. the server's hostname.
KEEL_HOST_LABEL=
KEEL_GATEWAY_PORT=8000
KEEL_STUDIO_PORT=3000
KEEL_DB_PORT=5432
# Which interface each port listens on. 127.0.0.1 keeps it on this machine
# only; 0.0.0.0 opens it to your network (and to the internet on a server with
# a public address: Docker's published ports bypass ufw/firewalld).
# The API is open; Studio and Postgres stay on this machine unless you choose
# otherwise (./keel init --lan opens Studio to your network).
KEEL_GATEWAY_BIND=0.0.0.0
KEEL_STUDIO_BIND=127.0.0.1
KEEL_DB_BIND=127.0.0.1
# Postgres connections from other machines need TLS (a self-signed certificate
# is made on first start) and a password, and the postgres superuser is refused
# unless this is "on". Keel's own containers and this machine are not affected.
KEEL_DB_REMOTE_SUPERUSER=off
# "remote" when Docker hides where connections come from (Docker Desktop on
# macOS and Windows, rootless Docker, Podman): there every client, this machine
# included, arrives from the Docker network's gateway, so with KEEL_DB_BIND=0.0.0.0
# those connections need TLS and can't sign in as postgres. "local" otherwise.
KEEL_DB_GATEWAY=local
# Studio sign-ins from the internet (through a tunnel, proxy or public address):
# 2fa = only for accounts with two-factor authentication (default), on, or off.
KEEL_STUDIO_INTERNET_LOGIN=2fa
# Host names Studio answers to besides IP addresses, localhost, local names
# (nas, nas.local, *.lan, *.ts.net) and the public addresses, comma-separated,
# for example studio.example.com (protects against DNS rebinding).
KEEL_STUDIO_HOSTS=
# What counts as your network: "private" (LAN ranges, Tailscale 100.64.0.0/10,
# this machine) or a comma-separated list of CIDRs.
KEEL_LOCAL_NETWORKS=private
# Proxies whose X-Forwarded-For Keel believes, besides its own (the gateway and
# Cloudflare Tunnel): "host" for Caddy, nginx or tailscale serve on this
# machine (automatic for a port bound to 127.0.0.1), or addresses, CIDR ranges
# and container names, comma-separated.
KEEL_TRUSTED_PROXIES=
# Limits against slow or flooding clients. Seconds a request body may stall
# before it's closed, open connections per client address, and realtime
# (WebSocket) connections per address and per project.
KEEL_BODY_IDLE_TIMEOUT=120
KEEL_MAX_CONNECTIONS_PER_IP=500
KEEL_REALTIME_MAX_PER_IP=200
KEEL_REALTIME_MAX_PER_PROJECT=10000

# --- Projects ---------------------------------------------------------------
# Created automatically on first start. Add more from Studio.
KEEL_DEFAULT_PROJECT=my-app

# --- Email (optional) -------------------------------------------------------
# Without SMTP, signups are confirmed automatically and magic links / reset
# links are written to the keel-auth log instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. SMTP_FROM="My App <no-reply@example.com>"
SMTP_FROM=
SMTP_SECURE=false

# --- Storage ----------------------------------------------------------------
KEEL_STORAGE_MAX_FILE_SIZE=52428800
# Signing key/salt (hex) for the internal image resizer.
IMGPROXY_KEY=
IMGPROXY_SALT=

# --- Edge functions ---------------------------------------------------------
# Memory per function process, wall-clock limit per request, idle shutdown (seconds),
# and how many function processes may run at once.
KEEL_FUNCTIONS_MEMORY_MB=256
KEEL_FUNCTIONS_TIMEOUT=150
KEEL_FUNCTIONS_IDLE=300
KEEL_FUNCTIONS_MAX_WORKERS=20
# Seconds a function may take to start (including downloading its imports).
KEEL_FUNCTIONS_BOOT_TIMEOUT=90
# LAN addresses edge functions may call, such as a local Ollama or a NAS
# (comma separated: 192.168.1.50:11434,10.0.0.7 or a range up to /24).
# Every port of a listed address is reachable, whatever port you write.
# Never list this server or Keel's containers; Keel ignores those.
# KEEL_FUNCTIONS_ALLOW_LAN=
# This server's own LAN addresses, comma separated. They stay closed to
# functions inside an allowed range; without them, only single addresses can
# be allowed. The installer and ./keel init fill this in.
KEEL_HOST_ADDRESSES=

# --- Backups ----------------------------------------------------------------
# Daily pg_dump of every project at this time (container time zone), or "off".
KEEL_BACKUP_SCHEDULE=03:00
KEEL_BACKUP_RETENTION=7
TZ=UTC
# Full backups: every database (projects, keys, settings, Studio accounts)
# and the uploaded files in one file, encrypted with this passphrase (12
# characters or more). Empty: off. Keep a copy of it somewhere other than
# this server: without it, the backups can't be opened.
KEEL_BACKUP_PASSPHRASE=
# Full backups kept on this machine (the newest ones).
KEEL_BACKUP_KEEP_LOCAL=2
# Copy full backups to an S3-compatible bucket (AWS S3, Backblaze B2,
# Cloudflare R2, Wasabi, MinIO...). You can set this up in Studio instead;
# these win when set. ./keel restore uses them on a new machine.
# KEEL_BACKUP_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# KEEL_BACKUP_S3_REGION=us-east-1
# KEEL_BACKUP_S3_BUCKET=
# KEEL_BACKUP_S3_PREFIX=keel
# KEEL_BACKUP_S3_ACCESS_KEY_ID=
# KEEL_BACKUP_S3_SECRET_ACCESS_KEY=
# KEEL_BACKUP_S3_PATH_STYLE=on

# --- Advanced ---------------------------------------------------------------
# Use published images instead of building locally.
# KEEL_IMAGE=ghcr.io/<owner>/keel:latest
# KEEL_FUNCTIONS_IMAGE=ghcr.io/<owner>/keel-functions:latest
# KEEL_DB_IMAGE=ghcr.io/<owner>/keel-postgres:latest
# Studio talks to Docker through the keel-docker socket proxy. Set to off
# (or empty) to disable container controls in Studio.
# KEEL_DOCKER_HOST=tcp://keel-docker:2375
KEEL_LOG_LEVEL=info
# Write email addresses, phone numbers and full request paths to the logs
# while debugging. Sign-in links and codes are never logged.
KEEL_LOG_PII=off
KEEL_SLOW_QUERY_MS=200
# Studio asks GitHub once a day, while you use it, whether a newer Keel release
# exists (an anonymous request; nothing about this install is sent). "off" stops it.
KEEL_UPDATE_CHECK=on
